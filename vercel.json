{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python scripts/build_site.py",
  "outputDirectory": ".build/site",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "excludeFiles": "{.build/**,Site/assets/**,Site/wasm/**,Site/quiz_perguntas.json,tests/**,test-results/**,.tools/**,.venv/**,backend/data/**,backend/recommender/build/**}"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{"key": "X-Content-Type-Options", "value": "nosniff"}]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{"key": "Cache-Control", "value": "public, max-age=3600, must-revalidate"}]
    },
    {
      "source": "/wasm/(.*)",
      "headers": [{"key": "Cache-Control", "value": "no-cache"}]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/resposta",
      "destination": "/api/index.py"
    }
  ]
}
